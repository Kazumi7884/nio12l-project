# Loopback-only publishing is enforced by Compose. Do not expose this HTTP listener to the Internet.
:80 {
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "no-referrer"
        X-Robots-Tag "noindex, nofollow"
    }

    handle /health {
        respond "OK" 200
    }

    # Homepage accesses Netdata over its private Docker network for its widget.
    # The reverse proxy deliberately does not expose Netdata's HTTP API.
    handle {
        reverse_proxy homepage:3000
    }
}
