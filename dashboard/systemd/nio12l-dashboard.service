# systemd service: nio12l-dashboard
# Auto-starts the Docker Compose dashboard stack on boot
# Uses existing Docker images — NO custom code

[Unit]
Description=NIO 12L Dashboard Stack (Caddy + Homepage + Netdata)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nio12l-dashboard
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
